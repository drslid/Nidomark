{
  "name": "nidomark",
  "description": "Local AI that tidies your browser bookmarks into clear folders. Private, offline, free.",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "build:all": "wxt build && wxt build -b firefox",
    "zip:all": "wxt zip && wxt zip -b firefox",
    "fetch-model": "node scripts/fetch-model.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "postinstall": "wxt prepare",
    "e2e": "node tests/e2e/chromium/smoke.mjs && node tests/e2e/chromium/sites.mjs && node tests/e2e/chromium/locales.mjs && node tests/e2e/chromium/roots.mjs",
    "e2e:firefox": "node tests/e2e/firefox/smoke.mjs && node tests/e2e/firefox/sites.mjs",
    "icons": "node scripts/make-icons.mjs",
    "store-images": "node scripts/make-store-images.mjs",
    "fixtures": "jiti scripts/fixture-vectors.ts",
    "examples": "jiti scripts/example-vectors.ts",
    "eval": "jiti scripts/eval.ts",
    "eval:big": "jiti scripts/eval-big.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2"
  },
  "devDependencies": {
    "puppeteer-core": "24.43.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-web": "1.31.1"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  }
}
